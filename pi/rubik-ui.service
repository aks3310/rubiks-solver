# systemd service: start the robot dashboard when the Pi boots.
# Install (edit User and the paths if your user or folder differ):
#   sudo cp rubik-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rubik-ui
# Logs: journalctl -u rubik-ui -f      Stop: sudo systemctl stop rubik-ui
[Unit]
Description=Rubik's cube robot dashboard (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/rubiks-solver/pi
ExecStart=/bin/bash /home/pi/rubiks-solver/pi/run_ui.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
